# Environment variables for the Coolify / Docker Compose PeerTube stack.
#
# On Coolify you don't need this file: Coolify detects every variable declared
# in docker-compose.yml and lets you set it from the UI (values left empty are
# generated automatically). This file is only a template for running the stack
# with a plain `docker compose up`: copy it to `.env` and adjust the values.

# -----------------------------------------------------------------------------
# Public instance URL
# -----------------------------------------------------------------------------

# Domain (without scheme) your instance is reachable at. It MUST match the
# domain you configure in Coolify (or your own reverse proxy).
PEERTUBE_WEBSERVER_HOSTNAME=peertube.example.com
PEERTUBE_WEBSERVER_HTTPS=true
PEERTUBE_WEBSERVER_PORT=443

# Generate one using `openssl rand -hex 32`
PEERTUBE_SECRET=

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

PEERTUBE_DB_HOSTNAME=postgres
PEERTUBE_DB_PORT=5432
PEERTUBE_DB_NAME=peertube
PEERTUBE_DB_USERNAME=peertube
# Generate one using `openssl rand -hex 32`
PEERTUBE_DB_PASSWORD=
PEERTUBE_DB_SSL=false

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------

PEERTUBE_REDIS_HOSTNAME=redis
PEERTUBE_REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Instance
# -----------------------------------------------------------------------------

PEERTUBE_ADMIN_EMAIL=admin@example.com
PEERTUBE_INSTANCE_NAME=PeerTube
PEERTUBE_SIGNUP_ENABLED=false
PEERTUBE_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Optional settings
# -----------------------------------------------------------------------------
# Any PEERTUBE_* variable listed in
# support/docker/production/config/custom-environment-variables.yaml can be
# added here (SMTP, object storage, live streaming, advanced auth...).
