{
  "name": "vdj-telegram-s3-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "S3-compatible gateway that stores selected Peertube object-storage buckets on Telegram (MTProto), served to Peertube as an S3 endpoint.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "smoke": "node test/smoke.mjs"
  },
  "optionalDependencies": {
    "input": "^1.0.1",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0"
  }
}
